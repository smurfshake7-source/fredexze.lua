-- Ride a Pet script project

local ScriptName = "Fredexze"
local Version = "1.0.0"

print(ScriptName .. " v" .. Version .. " loaded")

local Settings = {
    Speed = 16,
    AutoFarm = false,
    AutoEgg = false,
    AntiAFK = false
}

local function SetSetting(name, value)
    if Settings[name] ~= nil then
        Settings[name] = value
        print(name .. " = " .. tostring(value))
    end
end

SetSetting("Speed", 16)

print("Ready!")
