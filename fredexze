-- ═══════════════════ DRAG PANEL ═══════════════════
local Dragging, StartPos, MousePos = false, nil, nil
TitleBar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		Dragging = true
		StartPos = MainFrame.Position
		MousePos = i.Position
	end
end)
UIS.InputChanged:Connect(function(i)
	if Dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
		local d = i.Position - MousePos
		MainFrame.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + d.X, StartPos.Y.Scale, StartPos.Y.Offset + d.Y)
	end
end)
TitleBar.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then Dragging = false end
end)

-- ═══════════════════ FIND EGGS IN MAP ═══════════════════
local function GetEgg(name)
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") and v.Name:lower():find(name:lower()) then
			return v
		end
	end
	return nil
end

-- ═══════════════════ MAIN LOOP ═══════════════════
task.spawn(function()
	while task.wait(0.4) do
		if not Humanoid then UpdateCharacter() continue end

		-- Anti AFK
		if AntiAFKEnabled then
			pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
		end

		-- Auto Get Eggs
		if AutoBlackhole then
			local egg = GetEgg("blackhole")
			if egg and HumanoidRootPart then
				HumanoidRootPart.CFrame = egg.CFrame * CFrame.new(0, 2.5, 0)
				task.wait(0.15)
			end
		end
		if AutoGalaxy then
			local egg = GetEgg("galaxy")
			if egg and HumanoidRootPart then
				HumanoidRootPart.CFrame = egg.CFrame * CFrame.new(0, 2.5, 0)
				task.wait(0.15)
			end
		end
		if AutoCherub then
			local egg = GetEgg("cherub")
			if egg and HumanoidRootPart then
				HumanoidRootPart.CFrame = egg.CFrame * CFrame.new(0, 2.5, 0)
				task.wait(0.15)
			end
		end

		-- Apply Speed
		if SpeedEnabled and Humanoid then
			Humanoid.WalkSpeed = SpeedValue
		end
	end
end)

